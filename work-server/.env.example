# ===== 服务配置 =====
PORT=3001

# ===== 钉钉开放平台（未配置时进入演示模式）=====
# 企业内部应用凭据（钉钉开发者后台 - 应用信息）
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
# 企业 CorpId（需与前端 work-h5/.env 中 VITE_DINGTALK_CORP_ID 一致）
DINGTALK_CORP_ID=

# ===== 钉钉AI表格（阶段三）=====
# AI表格的 Base ID 与数据表 ID（或表名），建表后从表格URL/开放平台获取
DINGTALK_TABLE_BASE_ID=
DINGTALK_TABLE_SHEET_ID=

# ===== 浏览器访客登录 =====
# 开发期在普通浏览器测试时无需钉钉免登码，直接获得后端会话（浏览器访客）
# 生产公网部署务必设为 0，仅允许钉钉内免登
ALLOW_DEV_LOGIN=0

# ===== AI 智能查询（推荐在设置页在线配置，默认智谱GLM）=====
# 可选提供商：智谱GLM（open.bigmodel.cn，glm-4-flash 免费）/ 通义千问
# 此处预置 KEY 仅作首次播种，之后以设置页保存的为准
AI_API_KEY=
QWEN_API_KEY=

# ===== 语音识别（讯飞语音听写 WebAPI，推荐）=====
# 讯飞开放平台控制台 → 创建应用 → 语音听写（WebAPI）；传统引擎免费额度每日500次
# 也可在设置页「语音识别」卡片在线填写（以此处为首次播种）
XF_APP_ID=
XF_API_KEY=
XF_API_SECRET=

# ===== 管理员（阶段五）=====
# 逗号分隔的钉钉 userid，可查看全员工作记录与团队AI统计；演示模式下默认管理员
ADMIN_USERIDS=
